---
export const prerender = true;
import { getCollection } from "astro:content";
import { render } from "astro:content";
import General from "@layouts/General.astro";
import PostMetadata from "@components/PostMetadata.astro";
import { getCachedSortedBlogPosts } from "@utils/collectionCache";

export async function getStaticPaths() {
  // ⚡ Bolt Optimization: Use getCachedSortedBlogPosts instead of getCollection('blog')
  // This uses in-memory caching to avoid expensive file reads during static path generation
  const posts = await getCachedSortedBlogPosts();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props;

const { Content } = await render(post);
---

<General title={post.data.title} description={post.data.description}>
  <PostMetadata slot="head-slot" {...post.data} />
  <Content />
</General>
