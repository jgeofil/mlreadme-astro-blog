---
import PostCard from "@components/utilities/PostCard.astro";
import General from "@layouts/General.astro";
import { getCachedSortedBlogPosts } from "@utils/collectionCache";

// ⚡ Bolt Optimization: Replace getCollection with getCachedSortedBlogPosts to use in-memory caching
// This avoids expensive file system reads and sorting on every request to the blog index page, reducing TTFB.
const posts = await getCachedSortedBlogPosts();
---

<General title="Blog" description="Blog post index">
  <div class="my-5 grid grid-cols-2 gap-4">
    {posts.map((post, index) => <PostCard {...post} eager={index < 2} />)}
  </div>
</General>
